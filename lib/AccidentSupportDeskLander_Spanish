  p2Step = 4;
  document.getElementById('q-progress-label').textContent = 'Question 1 of ' + TOTAL_QUESTIONS;
  document.getElementById('q-progress-bar').style.width = Math.round((1 / TOTAL_QUESTIONS) * 100) + '%';
  window.scrollTo(0, 0);
}

// ─── Quiz (phase 1) ───
const qKeys = { 1: 'accidentTime', 2: 'fault', 3: 'injury' };

function selectQ(qNum, val) {
  answers[qKeys[qNum]] = val;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'form_progress', step_number: qNum });
  if (checkDisqualify(qKeys[qNum], val)) { showDisqualify('dq-notice-q' + qNum); return; }
  if (qNum < 3) showQ(qNum + 1);
  else transitionToPhase2();
}

function showQ(n, instant) {
  setRail('quiz-rail', n - 1, instant);
  quizStep = n;
  document.getElementById('q-progress-label').textContent = 'Question ' + n + ' of ' + TOTAL_QUESTIONS;
  document.getElementById('q-progress-bar').style.width = Math.round((n / TOTAL_QUESTIONS) * 100) + '%';
}

function goBack(fromStep) {
  if (fromStep === 2) { showQ(1); }
  else if (fromStep === 3) { showQ(2); }
  else if (fromStep === 4) {
    // Swipe phase2 out right, phase1 back in from left
    const phase2 = document.getElementById('phase2');
    const phase1 = document.getElementById('phase1');
    phase1.classList.remove('hidden');
    phase1.style.position = 'fixed';
    phase1.style.inset = '0';
    phase1.style.transform = 'translateX(-100%)';
    phase1.style.willChange = 'transform';
    phase1.style.transition = 'none';
    // Set quiz rail to Q3 instantly
    setRail('quiz-rail', 2, true);
    quizStep = 3;
    document.getElementById('q-progress-label').textContent = 'Question 3 of ' + TOTAL_QUESTIONS;
    document.getElementById('q-progress-bar').style.width = Math.round((3 / TOTAL_QUESTIONS) * 100) + '%';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const dur = '0.4s cubic-bezier(0.4, 0, 0.2, 1)';
        phase1.style.transition = `transform ${dur}`;
        phase2.style.transition = `transform ${dur}`;
        phase1.style.transform = 'translateX(0)';
        phase2.style.transform = 'translateX(100%)';
        setTimeout(() => {
          phase2.classList.add('hidden');
          phase2.style.transform = '';
          phase2.style.transition = '';
          phase1.style.position = '';
          phase1.style.inset = '';
          phase1.style.transform = '';
          phase1.style.transition = '';
          phase1.style.willChange = '';
          window.scrollTo(0, 0);
        }, 420);
      });
    });
  }
  else if (fromStep === 5) { showP2(4); }
  else if (fromStep === 6) { showP2(5); }
  else if (fromStep === 7) { showP2(6); }
  else if (fromStep === 8) { showP2(7); }
}

// ─── Phase 1 → Loading → Great News → Phase 2 ───
function transitionToPhase2() {
  document.getElementById('phase1').classList.add('hidden');
  document.body.classList.remove('quiz-active'); // drop green backdrop
  showLoadingSequence();
}

function showLoadingSequence() {
  const screen = document.getElementById('loading-screen');
  screen.classList.remove('hidden');

  const items = [
    { id: 'li1', iconId: 'li1-icon' },
    { id: 'li2', iconId: 'li2-icon' },
    { id: 'li3', iconId: 'li3-icon' },
  ];

  // Reset state
  items.forEach(({ id, iconId }) => {
    const el = document.getElementById(id);
    const icon = document.getElementById(iconId);
    el.classList.remove('visible','checked','spinning');
    icon.textContent = '';
  });

  // Step timings
  const delays      = [0, 300, 600];
  const checkDelays = [180, 480, 820];

  delays.forEach((delay, i) => {
    setTimeout(() => {
      const el = document.getElementById(items[i].id);
      el.classList.add('visible');
      if (i === 2) el.classList.add('spinning');
    }, delay);
  });

  checkDelays.forEach((delay, i) => {
    setTimeout(() => {
      const el   = document.getElementById(items[i].id);
      const icon = document.getElementById(items[i].iconId);
      el.classList.remove('spinning');
      el.classList.add('checked');
      icon.textContent = '✓';
    }, delay);
  });

  // After sequence: show Great News
  setTimeout(() => {
    screen.classList.add('hidden');
    showGreatNews();
  }, 1200);
}

function showGreatNews() {
  const canvas = document.getElementById('confetti-canvas');
  const gnScreen = document.getElementById('great-news-screen');
  canvas.classList.remove('hidden');
  gnScreen.classList.remove('hidden');
  gnScreen.style.transform = '';
  gnScreen.classList.remove('swipe-out');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  runConfetti(canvas);

  // After short display, swipe great-news left while phase2 swipes in from right
  setTimeout(() => {
    const phase2 = document.getElementById('phase2');

    // Position phase2 off-screen right, make it visible but shifted
    phase2.classList.remove('hidden');
    phase2.style.position = 'fixed';
    phase2.style.inset = '0';
    phase2.style.transform = 'translateX(100%)';
    phase2.style.willChange = 'transform';
    phase2.style.transition = 'none';
    p2Step = 4;
    setRail('p2-rail', 0, true);
    updateNav(4);

    // One rAF to paint, second to trigger both transitions simultaneously
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const swipeDuration = '0.45s cubic-bezier(0.4, 0, 0.2, 1)';
        phase2.style.transition = `transform ${swipeDuration}`;
        phase2.style.transform = 'translateX(0)';
        gnScreen.classList.add('swipe-out');
        canvas.classList.add('hidden');

        setTimeout(() => {
          // Clean up: remove fixed positioning from phase2
          phase2.style.position = '';
          phase2.style.inset = '';
          phase2.style.transform = '';
          phase2.style.transition = '';
          phase2.style.willChange = '';
          gnScreen.classList.add('hidden');
          gnScreen.classList.remove('swipe-out');
          window.scrollTo(0, 0);
        }, 460);
      });
    });
  }, 900);
}

function runConfetti(canvas) {
  const ctx = canvas.getContext('2d');
  const pieces = [];
  const colors = ['#f5c518','#4cce52','#ff6b6b','#74b9ff','#a29bfe','#fd79a8','#55efc4','#fdcb6e'];
  for (let i = 0; i < 200; i++) {
    pieces.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height * 0.6 - canvas.height * 0.3,
      w: Math.random() * 9 + 4, h: Math.random() * 5 + 2,
      color: colors[Math.floor(Math.random() * colors.length)],
      rotation: Math.random() * Math.PI * 2,
      rotSpeed: (Math.random() - 0.5) * 0.12,
      vx: (Math.random() - 0.5) * 2.5,
      vy: Math.random() * 3.5 + 1.5,
    });
  }
  let frame, start = null;
  function draw(ts) {
    if (!start) start = ts;
    if (ts - start > 1400) { cancelAnimationFrame(frame); return; }
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    pieces.forEach(p => {
      ctx.save();
      ctx.translate(p.x + p.w / 2, p.y + p.h / 2);
      ctx.rotate(p.rotation);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      ctx.restore();
      p.x += p.vx; p.y += p.vy; p.rotation += p.rotSpeed;
      if (p.y > canvas.height + 20) p.y = -20;
    });
    frame = requestAnimationFrame(draw);
  }
  frame = requestAnimationFrame(draw);
}

// ─── Phase 2 ───
const p2Index = { 4:0, 5:1, 6:2, 7:3, 8:4, 99:5 };

var phoneValidationReady = false;
