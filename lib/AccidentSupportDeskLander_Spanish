      campaign_id:   utmParams.campaign_id,
      adset_id:      utmParams.adset_id,
      ad_id:         utmParams.ad_id,
      placement:     utmParams.placement,
      fbclid:        utmParams.fbclid,
    })
  }).catch(function() {});

  // Fire Meta Lead event with dedup eventID
  var eventId = 'lead_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
  if (typeof fbq === 'function') {
    fbq('track', 'Lead', {}, { eventID: eventId });
  }

  showP2(99);
}
