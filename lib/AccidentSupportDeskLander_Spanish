// ── GHL full-viewport escape ──────────────────────────────────────────────
(function() {
  // 1. Build an override <style> and inject it into <head> LAST so it wins
  //    the cascade even against GHL's own !important rules.
  var overrideStyle = document.createElement('style');
  overrideStyle.id = 'asd-override';
  overrideStyle.textContent = [
    'html,body{margin:0!important;padding:0!important;',
      'width:100%!important;max-width:100%!important;overflow-x:hidden!important;}',
    '#ghl-escape{width:100%!important;max-width:none!important;',
      'margin:0!important;padding:0!important;}',
    /* Hide any GHL nav/header that sits above our content */
    'body>header,body>nav,body>.navbar,',
    'body>[class*="header"]:not(#ghl-escape),',
    'body>[class*="navbar"]:not(#ghl-escape),',
    'body>[id*="header"]:not(#ghl-escape),',
    'body>[id*="navbar"]:not(#ghl-escape){display:none!important;}',
  ].join('');
  document.head.appendChild(overrideStyle);

  // 2. Watch <head> for GHL injecting new <style>/<link> nodes after ours —
  //    re-append our override so it stays last in the cascade.
  if (window.MutationObserver) {
    new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        m.addedNodes.forEach(function(n) {
          if (n !== overrideStyle && (n.tagName === 'STYLE' || n.tagName === 'LINK')) {
            document.head.appendChild(overrideStyle);
          }
        });
      });
    }).observe(document.head, { childList: true });
  }

  // 3. Move #ghl-escape to be first child of <body>, clearing ancestor padding
  var el = document.getElementById('ghl-escape');
  if (el && el.parentNode !== document.body) {
    var node = el.parentNode;
    while (node && node !== document.body) {
      node.style.setProperty('padding-top', '0', 'important');
      node.style.setProperty('margin-top', '0', 'important');
      node = node.parentNode;
    }
    document.body.insertBefore(el, document.body.firstChild);
  }

  // 4. After full load, hide any remaining fixed/sticky GHL nav elements
  //    and measure + fix any leftover gap.
  window.addEventListener('load', function() {
    var ourIds = new Set(['ghl-escape','disqualify-screen','loading-screen','confetti-canvas','great-news-screen']);
    Array.from(document.body.children).forEach(function(child) {
      if (!ourIds.has(child.id) && child.tagName !== 'SCRIPT' && child.tagName !== 'STYLE' && child.tagName !== 'LINK') {
        var pos = window.getComputedStyle(child).position;
        if (pos === 'fixed' || pos === 'sticky') {
          child.style.setProperty('display', 'none', 'important');
        }
      }
    });
    // If a gap still remains, pull our escape div up to cover it
    var escEl = document.getElementById('ghl-escape');
    if (escEl) {
      var top = escEl.getBoundingClientRect().top;
      if (top > 1) {
        escEl.style.setProperty('margin-top', '-' + Math.ceil(top) + 'px', 'important');
      }
    }
  });
})();

