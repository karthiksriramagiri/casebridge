function setupPhoneValidation() {
  var phoneInput = document.getElementById('phone-input');
  var btn = document.getElementById('submit-btn');
  var lastValidated = '';

  // Error message element
  var err = document.createElement('div');
  err.style.cssText = 'color:#dc3545;font-size:13px;margin-top:6px;display:none;font-weight:500;';
  phoneInput.parentNode.insertBefore(err, phoneInput.nextSibling);

  // Loading element
  var loading = document.createElement('div');
  loading.style.cssText = 'color:#666;font-size:13px;margin-top:6px;display:none;';
  loading.textContent = 'Verifying...';
  phoneInput.parentNode.insertBefore(loading, err);

  // Disable submit until validated
  btn.disabled = true;
  btn.style.opacity = '0.5';
  btn.style.cursor = 'not-allowed';

  function setSubmitEnabled(enabled) {
    btn.disabled = !enabled;
    btn.style.opacity = enabled ? '1' : '0.5';
    btn.style.cursor = enabled ? 'pointer' : 'not-allowed';
  }

  // Reset on edit
  phoneInput.addEventListener('input', function () {
    err.style.display = 'none';
    phoneInput.style.borderColor = '';
    setSubmitEnabled(false);
    lastValidated = '';
  });

  // Validate on blur
  phoneInput.addEventListener('blur', function () {
    var digits = phoneInput.value.replace(/\D/g, '');
    if (digits.length < 10 || digits === lastValidated) return;
    lastValidated = digits;
    loading.style.display = 'block';
    err.style.display = 'none';
    setSubmitEnabled(false);

    var controller = new AbortController();
    var timer = setTimeout(function () { controller.abort(); }, 5000);

    fetch('https://case-bridge.com/api/validate-phone', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone: digits }),
      signal: controller.signal
    })
      .then(function (r) { clearTimeout(timer); return r.json(); })
      .then(function (data) {
        loading.style.display = 'none';
        if (data.valid) {
          phoneInput.style.borderColor = '#28a745';
          setSubmitEnabled(true);
        } else {
          phoneInput.style.borderColor = '#dc3545';
          err.textContent = 'This number is invalid.';
          err.style.display = 'block';
          setSubmitEnabled(false);
        }
      })
      .catch(function () {
        clearTimeout(timer);
        // Proxy unreachable or timed out — fail open
        loading.style.display = 'none';
        setSubmitEnabled(true);
      });
  });
}

function goToThankyou() {
  const phone = document.getElementById('phone-input').value.trim();
  if (!phone || phone.replace(/\D/g,'').length < 10) { alert('Please enter a valid phone number.'); return; }
