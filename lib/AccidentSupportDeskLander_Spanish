  }
  .anim-fade { animation: fadeIn 0.3s cubic-bezier(0.25,0.46,0.45,0.94) both; }

  /* Transition-based slide — no keyframes = no jank */
  .slide-ready {
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  .slide-entering {
    transition: opacity 0.26s cubic-bezier(0.25,0.46,0.45,0.94),
                transform 0.26s cubic-bezier(0.25,0.46,0.45,0.94);
  }

  /* ─── Loading / checking screen ─── */
