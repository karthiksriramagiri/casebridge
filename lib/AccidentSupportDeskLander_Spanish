  /* Phone field */
  .phone-wrap { display: flex; align-items: center; border: 1.5px solid #d1d5db; border-radius: 8px; overflow: hidden; background: #fff; transition: border-color 0.2s, box-shadow 0.2s; }
  .phone-wrap:focus-within { border-color: #4cce52; box-shadow: 0 0 0 3px rgba(76,206,82,0.12); }
  .phone-flag { padding: 0 12px; border-right: 1px solid #d1d5db; background: #f9fafb; height: 50px; display: flex; align-items: center; gap: 4px; font-size: 13px; color: #374151; white-space: nowrap; }
  .phone-input { flex: 1; border: none; outline: none; padding: 13px 14px; font-size: 15px; color: #1a1a1a; }

