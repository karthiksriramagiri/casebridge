  .dq-inline.phase-white-inner, .phase-white-inner .dq-inline { color: #dc2626; background: #fef2f2; border-color: #fecaca; }
  .micro-badges { display: flex; justify-content: center; gap: 6px; align-items: center; font-size: 13px; color: #6b7280; margin-bottom: 16px; flex-wrap: wrap; }
