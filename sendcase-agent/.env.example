# ── Claude ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Only needed when the API key is NOT scoped to a workspace (org-level keys
# return a 400 demanding this). Find it in the Console under Settings →
# Workspaces, or create a workspace-scoped key instead and leave this blank.
ANTHROPIC_WORKSPACE_ID=

# ── GoHighLevel ─────────────────────────────────────────────────────────────
# The 200k/day quota is metered PER LOCATION, so this service shares one bucket
# with the dialer, the metrics dashboards and the Next app. A separate token
# does NOT get a separate bucket — this was tested.
GHL_API_KEY=
GHL_LOCATION_ID=AGAoUCwWTwc4Bqslwt9r

# Self-imposed ceiling on GHL calls this service may spend per day.
GHL_DAILY_BUDGET=20000
# Refuse to run when the location's remaining daily quota drops below this, so
# the agent can never starve the dialer.
GHL_RESERVE_FLOOR=20000
# Burst limiter (GHL allows 100 per 10s; stay well under).
GHL_MAX_PER_10S=40

# ── Trigger ─────────────────────────────────────────────────────────────────
# The tag that marks a case as Pending Send.
PS_TAG=-ps
# Set to 0 to skip re-verifying the tag on webhook delivery.
REQUIRE_PS_TAG=1

# ── Supabase (drives the /sendcase page) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Slack ───────────────────────────────────────────────────────────────────
# This project uses a separate webhook per channel — set this to whichever
# channel should get "ready for review" pings. Do not reuse another channel's.
SLACK_SENDCASE_WEBHOOK=
SENDCASE_URL=https://case-bridge.com/sendcase

# ── Service ─────────────────────────────────────────────────────────────────
# Shared secret required on /webhooks, /backfill and /run.
AGENT_SECRET=
PORT=3000
# Max accident photos attached per case (0 disables vision).
MAX_PHOTOS=6
