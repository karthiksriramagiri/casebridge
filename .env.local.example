NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GHL_API_KEY_SENDCASE=

# Set to 1 to count every GHL API call per calling file into ghl_call_counts.
# Diagnostic for the 200k/day location quota — safe to leave off.
# Requires supabase/migration_ghl_usage.sql.
GHL_USAGE_TRACKING=0

# Commas / Fanbasis public API key (Account → API Keys, needs the "payments" scope)
FANBASIS_API_KEY=

# Upwork API key (Settings → API Keys). Callback must be <base>/api/upwork/callback
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# Slack webhook the Creative Center posts the finished kill list into, so the
# person working Ads Manager knows the list is ready without being told by hand.
# Incoming Webhooks → the K-Team's channel. A webhook is a bearer credential:
# anyone holding it can post into that channel, so it never goes in the repo.
SLACK_CREATIVE_KILL_WEBHOOK=

# Threading the Creative Center's Slack messages. With a bot token (chat:write)
# and the channel ids below, every message about a brief replies under the
# first one instead of starting its own message in the channel. Without them
# the center falls back to the webhooks above and posts unthreaded, as before.
# The ids are the channels those two webhooks already post into — C0123ABCD.
SLACK_CREATIVE_REVIEW_CHANNEL=
SLACK_CREATIVE_REVISE_CHANNEL=

# The Creative Center's own Slack bot token (chat:write), used to thread its
# messages. Separate from SLACK_BOT_TOKEN on purpose: that one is read by the
# lead-claim handler in /api/slack/events, and filling it in to get threading
# here would switch that back on as a side effect.
SLACK_CREATIVE_BOT_TOKEN=

# The channel the Creative Center threads a brief's conversation into. One
# channel, because a Slack thread cannot span two. A #name works as well as
# an id while the bot holds chat:write.public — but QUOTE it: an unquoted #
# opens a comment in a dotenv file and the value reads as empty.
SLACK_CREATIVE_CHANNEL="#creative-feedback-update"

# The channel the kill list and launch list thread their day into. Jason's
# "list is ready" starts the thread; the K-Team's "list is done" replies
# under it and is broadcast back to the channel so he sees it. Quote it —
# see the note above.
SLACK_CREATIVE_OPS_CHANNEL="#kill-launch-update"
