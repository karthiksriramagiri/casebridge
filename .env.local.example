NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GHL_API_KEY_SENDCASE=

# Set to 1 to count every GHL API call per calling file into ghl_call_counts.
# Diagnostic for the 200k/day location quota — safe to leave off.
# Requires supabase/migration_ghl_usage.sql.
GHL_USAGE_TRACKING=0

# Commas / Fanbasis public API key (Account → API Keys, needs the "payments" scope)
FANBASIS_API_KEY=
