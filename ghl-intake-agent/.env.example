# --- GoHighLevel (LeadConnector) API v2 ---
# Private Integration or OAuth token with scopes: conversations.readonly,
# contacts.readonly, contacts.write, opportunities.readonly, opportunities.write
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# --- Shared secret so random requests can't hit your webhook ---
# Put this same value in the GHL workflow's webhook header config.
WEBHOOK_SHARED_SECRET=change-me

# --- The tag that triggers intake fill-out (must match the GHL workflow trigger) ---
SIGNED_TAG=signed-case
DONE_TAG=intake-ready-for-review

# --- Twilio (only needed if you're pulling call recordings from your in-house dialer) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# If you use Twilio Voice Intelligence for transcription, set the Service SID:
TWILIO_INTELLIGENCE_SERVICE_SID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

PORT=3000
